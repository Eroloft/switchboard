# Copy this file to `.env` and fill in what you have.
# With NO keys at all, Switchboard runs on fake "mock" models so you can try it.
PORT=4000

# Optional real providers:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Which concrete models the strategies use.
# Auto-picked from your keys: Anthropic -> claude-haiku-4-5 / claude-opus-4-8;
# else OpenAI -> gpt-4o-mini / gpt-4o; else the keyless mock models.
# Override explicitly if you want a different pairing:
# CHEAP_MODEL=claude-haiku-4-5
# STRONG_MODEL=claude-opus-4-8

# Where cumulative stats are stored (SQLite file).
# STATS_DB=switchboard.db

# Free local mode via Ollama (cheap=qwen3.5:2b, strong=qwen2.5-coder:7b).
# LOCAL=1
# OLLAMA_BASE_URL=http://localhost:11434

# auto-classify: difficulty >= this routes to the strong model (default 0.4).
# CLASSIFY_THRESHOLD=0.4

# Path to an optional JSON config file (defaults to ./switchboard.config.json).
# SWITCHBOARD_CONFIG=switchboard.config.json
